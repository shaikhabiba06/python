n = int(input("Enter number of months: "))

bills = []

for i in range(n):
    print("\nMonth", i + 1)

    units = float(input("Enter electricity units consumed: "))

    if units <= 100:
        bill = units * 2
    elif units <= 200:
        bill = (100 * 2) + (units - 100) * 3
    elif units <= 300:
        bill = (100 * 2) + (100 * 3) + (units - 200) * 5
    else:
        bill = (100 * 2) + (100 * 3) + (100 * 5) + (units - 300) * 7

    fixed_charge = 50
    surcharge = bill * 0.05
    total = bill + fixed_charge + surcharge

    if units < 100:
        rebate = total * 0.05
        total = total - rebate

    bills.append(total)

    print("Electricity Bill:", round(total, 2))

print("\nMonthly Bill Comparison")

for i in range(n):
    print("Month", i + 1, "Bill:", round(bills[i], 2))

    if i > 0:
        increase = bills[i] - bills[i - 1]

        if increase > bills[i - 1] * 0.25:
            print("Unusual Increase Detected")
        elif increase > 0:
            print("Bill Increased")
        else:
            print("Bill Decreased or Remained Same")